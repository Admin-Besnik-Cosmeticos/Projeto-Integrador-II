# Copie para .env.development (dev local) e configure no painel da Vercel (producao).
# Nunca commite arquivos .env com valores reais.

# Postgres (Neon) — mesma variavel usada pela API (database/db.ts) e pelo migrate (database/).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=12

# E-mail (recuperacao de senha) - Gmail; EMAIL_FROM usa EMAIL_USER por padrao
EMAIL_PROVIDER=disabled
EMAIL_USER=seu-email@gmail.com
EMAIL_APP_PASSWORD=
