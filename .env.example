# Copie para .env.development (dev local) e configure no painel da Vercel (producao).
# Nunca commite arquivos .env com valores reais.

# Postgres (Neon) — mesma variavel usada pela API (database/db.ts) e pelo migrate (database/).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/neondb?sslmode=require

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=12

// E-mail (recuperacao de senha) - Gmail via Senha de App
EMAIL_PROVIDER=gmail
EMAIL_USER=admin.besnikcosmeticos@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_FROM="Besnik Cosméticos <admin.besnikcosmeticos@gmail.com>"

// Configurações do deploy na Vercel (OIDC Token para deploys automáticos)
VERCEL_OIDC_TOKEN=
VERCEL_TARGET_ENV=
VERCEL_URL="https://projeto-integrador-ii-snowy.vercel.app/login"
