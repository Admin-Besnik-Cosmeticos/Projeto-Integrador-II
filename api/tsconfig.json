{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "rootDir": "..",
    "outDir": "dist",
    "paths": {
      "@vercel/node": ["./node_modules/@vercel/node"],
      "@neondatabase/serverless": ["./node_modules/@neondatabase/serverless"]
    }
  },
  "include": ["./**/*.ts", "../services/**/*.ts", "../database/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
